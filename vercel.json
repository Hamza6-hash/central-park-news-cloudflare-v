{
    "crons": [
        {
            "path": "/api",
            "schedule": "0 4,20 * * *"
        }
    ],
    "version": 2,
    "builds": [
      {
        "src": "app/api/index.py",
        "use": "@vercel/python"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "/app/api/index.py"
      }
    ]
}