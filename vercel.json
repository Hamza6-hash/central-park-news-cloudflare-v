{
    "redirects": [
      {
        "source": "/(.*)",
        "has": [
          {
            "type": "host",
            "value": "central-park-news.vercel.app"
          }
        ],
        "destination": "https://www.centralpark.news/$1",
        "permanent": true
      }
    ],
    "headers": [
      {
        "source": "/(.*)",
        "has": [
          {
            "type": "host",
            "value": "central-park-news.vercel.app"
          }
        ],
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ]
  }