# Database - Prisma (PostgreSQL) - used for subscribe, contact, etc.
DATABASE_URL="postgresql://user:password@localhost:5432/central_park_news?schema=public"

# CMS (Newstrix) - Step 3 from setup guide
# 1. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 2. CMS .env.local: SITE_API_KEYS=centralparkNews:<hex-key>
# 3. News site (here): use ONLY the hex key, not siteName:key
CMS_BASE_URL="https://cms.newstrix.com"
CMS_API_KEY="<hex-key-from-step-1>"

# Site
NEXT_PUBLIC_SITE_URL="https://www.centralpark.news"
NEXT_PUBLIC_API_URL="https://www.centralpark.news"

# SendGrid (Newsletter + Contact form)
SendGridApiKey=""
SENDGRID_LIST_ID=""

# Unsubscribe token secret (generate a long random string)
TOKEN_SECRET="your-secret-key-make-it-long-and-random"
